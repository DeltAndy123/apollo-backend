# Copy this file to .env and fill in the values.
# The infrastructure URLs (postgres, redis) are set in docker-compose.yml and
# do not need to be repeated here.

# ---------------------------------------------------------------------------
# Apple APNs — required for push notifications to actually deliver
# ---------------------------------------------------------------------------

# Bundle ID of the app registered in your Apple Developer account with Push Notifications enabled.
# Must match the bundle ID used when signing/installing the Apollo IPA.
# Cannot be the same as the original bundle ID (com.christianselig.Apollo).
APPLE_BUNDLE_ID=com.christianselig.Apollo

# 10-character Key ID from Apple Developer → Certificates, Identifiers & Profiles → Keys
APPLE_KEY_ID=XXXXXXXXXX

# 10-character Team ID from Apple Developer → Membership
APPLE_TEAM_ID=XXXXXXXXXX

# Path inside the container where your .p8 key is mounted.
# Place the file at ./secrets/apple.p8 (docker-compose mounts ./secrets → /etc/secrets).
APPLE_KEY_PATH=/etc/secrets/apple.p8

# App Store Connect shared secret for receipt validation.
# App Store Connect → Apps → Apollo → Subscriptions → App-Specific Shared Secret
APPLE_SHARED_SECRET=your_32char_hex_shared_secret

# ---------------------------------------------------------------------------
# Reddit — required for polling the Reddit API on behalf of users
# ---------------------------------------------------------------------------

# Client ID from https://www.reddit.com/prefs/apps
# The client ID shown on the app page.
# NOTE: This must be the same as the "Reddit API Key" you configured in Apollo.
REDDIT_CLIENT_ID=your_reddit_app_client_id

# Client secret shown on the same app page.
# Optional, only required if your API key is for a "web app" instead of an "installed app".
REDDIT_CLIENT_SECRET=your_reddit_app_client_secret

# User-Agent sent with every Reddit API request.
# Reddit blocks Apollo-related user agents — use something unique to avoid being blocked.
# Format: <platform>:<app ID>:<version> (by /u/<your_reddit_username>)
REDDIT_USER_AGENT=server:push-notification-backend:v1.0 (by /u/your_reddit_username)

# ---------------------------------------------------------------------------
# Security — optional but strongly recommended if the server is publicly accessible
# ---------------------------------------------------------------------------

# Secret token required in the X-Apollo-Token header on every request.
# Leave empty to disable authentication (not recommended for public servers).
# Set this to any long random string, then enter the same value in Apollo's
# Custom API settings → "Server Secret Token".
APOLLO_SECRET_TOKEN=your_secret_token_here

# ---------------------------------------------------------------------------
# Optional — leave blank to disable
# ---------------------------------------------------------------------------

# Bugsnag error tracking
# BUGSNAG_API_KEY=

# Datadog metrics (also set STATSD_URL=localhost:8125 if using a local agent)
# DD_API_KEY=
# STATSD_URL=

# smtp2go for contact-form emails (/v1/contact endpoint)
# SMTP2GO_API_KEY=
